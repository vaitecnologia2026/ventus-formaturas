# ============================================================
# Ventus Backend — variáveis de ambiente
# Copie para `.env` e preencha. Não commitar `.env`.
# ============================================================

# --- Banco PostgreSQL (Prisma usa DATABASE_URL; também aceitamos as variáveis discretas) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ventus
DB_USER=ventus
DB_PASS=changeme
DB_SSL=false
# Prisma exige uma URL única — gerada a partir das variáveis acima se não definida
DATABASE_URL=postgresql://ventus:changeme@localhost:5432/ventus?schema=public

# --- Servidor HTTP ---
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# --- JWT ---
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-real-48-byte-random-secret
JWT_EXPIRES_IN=12h

# --- Google Ads API ---
# Documentação: https://developers.google.com/google-ads/api/docs/get-started/introduction
# OAuth refresh token gerado em: https://developers.google.com/google-ads/api/docs/oauth/playground
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_CONVERSION_ACTION_NAME=
GOOGLE_ADS_DEFAULT_CURRENCY=BRL
# Modos válidos: enhanced_conversions_for_leads | offline_click_conversion | data_manager_api
GOOGLE_ADS_UPLOAD_MODE=offline_click_conversion

# --- pg-boss (fila de retry) ---
# Por padrão usa o mesmo DATABASE_URL e cria o schema `pgboss`
PGBOSS_SCHEMA=pgboss
