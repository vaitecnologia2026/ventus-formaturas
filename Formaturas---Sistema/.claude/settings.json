      "Bash(git commit *)",
      "Bash(git stash *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(npx *)",
      "Bash(pnpm run *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(node *)",
      "Bash(python3 *)",
      "Bash(python3 -m http.server *)",
      "Bash(prisma generate)",
      "Bash(prisma studio)",
      "Bash(prisma migrate dev *)",
      "Read(./novo-sistema-html/**)",
      "Read(./docs/**)",
      "Read(./prototipo/**)",
      "Read(./Sistema Ventus/**)",
