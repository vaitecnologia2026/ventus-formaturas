      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(prisma migrate deploy)",
      "Bash(prisma migrate reset *)",
      "Bash(prisma db push *)",
      "Bash(asaas-cli *)",
      "Bash(gh release *)",
      "Bash(gh pr merge *)"
