      "Bash(rm -rf /*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(> /dev/sda)",
      "Bash(mkfs *)",
