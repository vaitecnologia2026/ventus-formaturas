{
  "name": "formaturas-novo",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Ventus Formaturas — sucessora do legado ventus.rpsys.com.br",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "db:generate": "pnpm --filter @formaturas/shared-db exec prisma generate",
    "db:migrate": "pnpm --filter @formaturas/shared-db exec prisma migrate dev",
    "db:push": "pnpm --filter @formaturas/shared-db exec prisma db push",
    "db:studio": "pnpm --filter @formaturas/shared-db exec prisma studio",
    "db:seed": "pnpm --filter @formaturas/shared-db exec tsx prisma/seed.ts",
    "etl:legacy": "tsx tools/etl-legacy/index.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
